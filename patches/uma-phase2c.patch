diff --git a/apps/desktop/src/about.ts b/apps/desktop/src/about.ts
new file mode 100644
index 00000000..3a157ac2
--- /dev/null
+++ b/apps/desktop/src/about.ts
@@ -0,0 +1,80 @@
+/** Product information for the About prompt; never carries account data, paths or credentials. */
+
+import { formatDesktopMessage, type DesktopMessages } from './locale.ts'
+
+/** Runtime facts the shell owns, injected so the copy stays testable without Electron. */
+export interface DesktopAboutFacts {
+  readonly productName: string
+  readonly productVersion: string
+  /** Kernel version reported by the packaged runtime tree, or null when it cannot be read. */
+  readonly kernelVersion: string | null
+  readonly development: boolean
+  readonly channel: string | null
+  readonly platform: string
+  readonly arch: string
+  readonly electron: string
+  readonly chromium: string
+  readonly node: string
+  /** Packaged manifest fields (build commit) read from the application's package.json. */
+  readonly manifest: unknown
+}
+
+/** Localized About body plus the plain-text summary the copy action writes to the clipboard. */
+export interface DesktopAboutContent {
+  readonly detail: string
+  readonly about: {
+    readonly version: string
+    readonly rows: readonly { readonly label: string; readonly value: string }[]
+    readonly upstream: string
+    readonly copyright: string
+  }
+  readonly technicalDetails: string
+  readonly licenseDetails: string
+}
+
+/**
+ * Build localized product information without account details, local paths or credentials.
+ * @param facts - Application version and independently read kernel version.
+ * @param messages - Current shell dictionary.
+ * @returns About content and a plain-text support summary.
+ */
+export function desktopAboutContent(facts: DesktopAboutFacts, messages: DesktopMessages): DesktopAboutContent {
+  const channel = facts.development
+    ? messages.aboutDevelopment
+    : facts.channel === 'stable' ? messages.aboutStable
+      : facts.channel === 'nightly' ? messages.aboutPreview
+        : messages.aboutUnavailable
+  const system = `${facts.platform === 'darwin' ? 'macOS' : facts.platform === 'win32' ? 'Windows' : facts.platform} · ${facts.arch}`
+  const kernel = facts.kernelVersion === null ? messages.aboutUnavailable : `DeepSeek Harness ${facts.kernelVersion}`
+  const rows = [
+    { label: messages.aboutKernel, value: facts.kernelVersion ?? messages.aboutUnavailable },
+    { label: messages.aboutChannel, value: channel },
+    { label: messages.aboutPlatform, value: system },
+  ]
+  const diagnostics = [
+    `${facts.productName} ${facts.productVersion}`,
+    `${messages.aboutKernel}: ${kernel}`,
+    `${messages.aboutChannel}: ${channel}`,
+    `${messages.aboutPlatform}: ${system}`,
+    `Electron: ${facts.electron}`,
+    `Chromium: ${facts.chromium}`,
+    `Node.js: ${facts.node}`,
+  ]
+  const manifest = facts.manifest
+  if (typeof manifest === 'object' && manifest !== null && 'dshBuildCommit' in manifest
+    && typeof manifest.dshBuildCommit === 'string' && /^[0-9a-f]{40}$/u.test(manifest.dshBuildCommit)) {
+    diagnostics.push(`${messages.aboutBuild}: ${manifest.dshBuildCommit}`)
+    if ('dshBuildDirty' in manifest && manifest.dshBuildDirty === true) diagnostics.push(messages.aboutModified)
+  }
+  return {
+    detail: messages.aboutDescription,
+    about: {
+      version: formatDesktopMessage(messages.aboutVersion, { version: facts.productVersion }),
+      rows,
+      upstream: messages.aboutUpstream,
+      copyright: `© ${facts.productName}`,
+    },
+    technicalDetails: diagnostics.join('\n'),
+    licenseDetails: 'DeepSeek Harness\nMIT License\nCopyright (c) 2026 DeepSeek',
+  }
+}

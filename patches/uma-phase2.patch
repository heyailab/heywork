+
+/**
+ * Select the UMA distribution's own data root without consulting the kernel's DSH_HOME
+ * override (mirrors the UMA shell's `resolveUmaDesktopHome`; no legacy data migration).
+ * @param env - Process environment containing optional UMA_HOME.
+ * @param userHome - Operating-system account home.
+ * @returns Absolute application data root (`$UMA_HOME` or `~/.uma`).
+ */
+export function resolveUmaDesktopHome(env: Record<string, string | undefined> = process.env, userHome: string = homedir()): string {
+  return resolveDshHome(env.UMA_HOME?.trim() || join(userHome, '.uma'), {})
+}

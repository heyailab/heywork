diff --git a/apps/desktop/src/updates/electron-updater/cache-sweep.ts b/apps/desktop/src/updates/electron-updater/cache-sweep.ts
new file mode 100644
index 00000000..0f623507
--- /dev/null
+++ b/apps/desktop/src/updates/electron-updater/cache-sweep.ts
@@ -0,0 +1,63 @@
+/** Reclaim the fixed-name download staging electron-updater leaves at the update cache root. */
+
+import { readFileSync } from 'node:fs'
+import { rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { recordUpdateCleanupFailure } from '../../update-cleanup-log.ts'
+
+/**
+ * Names the updater rewrites at the cache root on every download, outside `pending/`.
+ * `DownloadedUpdateHelper` only ever empties `pending/`, so a completed install leaves
+ * these behind and the update package ends up stored twice.
+ */
+const STAGING_FILES = ['update.zip', 'current.blockmap'] as const
+
+/** Key electron-updater reads through `configOnDisk` to name its cache directory. */
+const CACHE_DIR_KEY = 'updaterCacheDirName:'
+
+/**
+ * Resolve the directory electron-updater stages downloads in.
+ * Mirrors `path.join(app.baseCachePath, updaterCacheDirName || app.name)`; the fallback
+ * applies only when a build shipped no configuration, where the updater is disabled anyway.
+ * @param resources - Packaged resources directory containing `app-update.yml`.
+ * @param cacheRoot - `app.getPath('cache')`.
+ * @param applicationName - Name used by electron-updater when the configuration omits the key.
+ * @returns Absolute cache directory owned by the updater.
+ */
+export function resolveUpdaterCacheDirectory(resources: string, cacheRoot: string, applicationName: string): string {
+  let name = applicationName
+  try {
+    const line = readFileSync(join(resources, 'app-update.yml'), 'utf8')
+      .split('\n')
+      .map(entry => entry.trim())
+      .find(entry => entry.startsWith(CACHE_DIR_KEY))
+    const value = line?.slice(CACHE_DIR_KEY.length).trim().replace(/^['"]|['"]$/gu, '')
+    if (value !== undefined && value !== '') name = value
+  }
+  catch { /* An absent configuration keeps the library's own fallback; nothing to reclaim either. */ }
+  return join(cacheRoot, name)
+}
+
+/**
+ * Remove the fixed-name staging files a settled update left behind.
+ * Runs before the first check of a fresh process, when no download can be in flight.
+ * A missing file is not a failure; an unremovable one is logged without reviving the target.
+ * @param directory - Directory returned by {@link resolveUpdaterCacheDirectory}.
+ * @param logs - Shell-owned log directory for durable cleanup warnings.
+ * @returns Names that were actually removed.
+ */
+export async function sweepDesktopUpdateCache(directory: string, logs: string): Promise<readonly string[]> {
+  const removed: string[] = []
+  for (const name of STAGING_FILES) {
+    const path = join(directory, name)
+    try {
+      await rm(path)
+      removed.push(name)
+    }
+    catch (error) {
+      if (error instanceof Error && 'code' in error && error.code === 'ENOENT') continue
+      recordUpdateCleanupFailure(logs, { operation: 'remove', path, error })
+    }
+  }
+  return removed
+}

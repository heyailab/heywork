{
  "name": "@deepseek-ai/dsh-uma-base",
  "description": "HEY shared Host services and product profile metadata",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json",
    "./profiles": {
      "types": "./lib/types/profiles.d.ts",
      "default": "./lib/profiles.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./experience-capture": {
      "types": "./lib/types/experience-capture.d.ts",
      "default": "./lib/experience-capture.js"
    },
    "./project-memory": {
      "types": "./lib/types/project-memory.d.ts",
      "default": "./lib/project-memory.js"
    },
    "./weknora": {
      "types": "./lib/types/weknora.d.ts",
      "default": "./lib/weknora.js"
    },
    "./operations-ssh": {
      "types": "./lib/types/operations-ssh.d.ts",
      "default": "./lib/operations-ssh.js"
    },
    "./feedback": {
      "types": "./lib/types/feedback.d.ts",
      "default": "./lib/feedback.js"
    }
  },
  "files": [
    "NOTICE.md",
    "locale/*.json",
    "lib/index.js",
    "lib/profiles.js",
    "cordis.patch.yml",
    "presets/repo-wiki.patch.yml",
    "presets/uma-design.patch.yml",
    "presets/uma-office.patch.yml",
    "presets/uma-role-author.patch.yml",
    "presets/uma-role-reviewer.patch.yml",
    "presets/uma-team.patch.yml",
    "lib/experience-capture.js",
    "lib/project-memory.js",
    "lib/weknora.js",
    "lib/operations-ssh.js",
    "lib/feedback.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/repo-wiki.patch.yml",
        "./presets/uma-design.patch.yml",
        "./presets/uma-office.patch.yml",
        "./presets/uma-role-author.patch.yml",
        "./presets/uma-role-reviewer.patch.yml",
        "./presets/uma-team.patch.yml"
      ]
    }
  },

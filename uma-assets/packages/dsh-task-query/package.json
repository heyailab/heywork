{
  "name": "@deepseek-ai/dsh-task-query",
  "description": "Recoverable bounded current-task queries for workspace knowledge retrieval",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"

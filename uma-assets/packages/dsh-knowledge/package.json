{
  "name": "@deepseek-ai/dsh-knowledge",
  "description": "Desktop team and project knowledge with local document indexing and source-backed development context",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./context": {
      "types": "./lib/types/context.d.ts",
      "default": "./lib/context.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/context.js",
    "lib/pdf-worker.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-office-kit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.3",
    "@deepseek-ai/dsh-task-query": "0.2.2-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "zod": "4.6.6",
    "pdfjs-dist": "6.3.289",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-uma-delivery": "0.2.2-rc.3"
  }
}
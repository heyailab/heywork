{
  "name": "@deepseek-ai/dsh-client-ui-uma-task-budget",
  "description": "HEY session financial allowance, shared agent budget and account-owned controls",
  "version": "0.2.2-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umacloud/umastudio.git",
    "directory": "packages/client/ui-hey-task-budget"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-deepseek-account": "0.2.2-rc.3",
    "@deepseek-ai/dsh-uma-task-budget": "0.2.2-rc.3",
    "@testing-library/react": "^16.3.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-remote-mock": "0.2.2-rc.3"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "private": true
}
{
  "name": "@deepseek-ai/dsh-client-ui-design-studio",
  "description": "The Design Studio and Delivery Workbench pages: design-system gallery, token preview, preset launchers, delivery pipeline, and bundled skills",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-uma-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-resources": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-uma-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-crypto": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-uma-delivery": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@novnc/novnc": "1.5.0",
    "@testing-library/react": "^16.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "NOTICE.md",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
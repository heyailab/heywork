{
  "name": "@deepseek-ai/dsh-tool-repo-wiki",
  "description": "Evidence-grounded repository Wiki generation, incremental updates and knowledge retrieval",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./context": {
      "types": "./lib/types/context.d.ts",
      "default": "./lib/context.js"
    },
    "./workspace": {
      "types": "./lib/types/workspace.d.ts",
      "default": "./lib/workspace.js"
    },
    "./workspace-types": {
      "types": "./lib/types/workspace-types.d.ts",
      "default": "./lib/types/workspace-types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/context.js",
    "lib/workspace.js",
    "lib/config-*.js",
    "lib/repository-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.2-rc.3",
    "@types/js-yaml": "^4.0.9",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-task-query": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-repo-wiki": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.4.3",
    "js-yaml": "^4.3.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3"
  }
}